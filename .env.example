# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY= XXXXXX
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/raices_brain

# ─── Vector DB ────────────────────────────────────────────────────────────────
# Opción A: pgvector (usa DATABASE_URL)
# Opción B: Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=raices-brain

# ─── GitHub (ingesta de conocimiento desde repos) ─────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=raices-desarrollos/raices-brain

# ─── Google Drive (ingesta de documentos) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ─── Autenticación ────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
