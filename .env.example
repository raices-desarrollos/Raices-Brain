# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/raices_brain

# ─── Autenticación (obligatorio para el login) ────────────────────────────────
NEXTAUTH_SECRET=genera_con_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000
# En Vercel (producción): https://raices-brain.vercel.app  (sin barra al final)

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ─── Storage de documentos ────────────────────────────────────────────────────
# 'local' usa ./uploads/ en el servidor. Para producción: 'supabase' o 's3'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# ─── Configuración de producción ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://brain.raicesdesarrollos.com
NODE_ENV=production

# ─── Creación de usuarios (solo para el script create-users) ─────────────────
USER1_EMAIL=socio1@raicesdesarrollos.com
USER1_PASSWORD=
USER1_NAME=Darío
USER2_EMAIL=socio2@raicesdesarrollos.com
USER2_PASSWORD=
USER2_NAME=
USER3_EMAIL=socio3@raicesdesarrollos.com
USER3_PASSWORD=
USER3_NAME=

# ─── Opcionales (Brain/RAG) ───────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=raices-brain
GITHUB_TOKEN=
GITHUB_REPO=raices-desarrollos/raices-brain
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Carpeta opcional para facturas subidas desde la app.
# Si no está, se crea (o reutiliza) una carpeta "Facturas" dentro de GOOGLE_DRIVE_FOLDER_ID.
GOOGLE_DRIVE_INVOICES_FOLDER_ID=

